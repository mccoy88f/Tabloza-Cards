# Copia in .env e personalizza
POSTGRES_USER=tabloza
POSTGRES_PASSWORD=tabloza
POSTGRES_DB=tabloza
# Genera con: openssl rand -hex 32
JWT_SECRET=cambiami-con-una-stringa-casuale-lunga-almeno-32-caratteri
# Porta sull host, solo con docker-compose.local.yml
APP_PORT=3000

# Solo per eseguire il backend fuori da Docker (cargo run -p backend)
DATABASE_URL=postgres://tabloza:tabloza@localhost:5432/tabloza
STATIC_DIR=dist
# Abilita CORS per lo sviluppo con `dx serve` (frontend su :8080)
# CORS_ORIGIN=http://localhost:8080
