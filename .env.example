# Copia in .env e personalizza
POSTGRES_USER=tabloza
POSTGRES_PASSWORD=tabloza
POSTGRES_DB=tabloza
# Genera con: openssl rand -hex 32
JWT_SECRET=cambiami-con-una-stringa-casuale-lunga-almeno-32-caratteri
# Porta sull host, solo con docker-compose.local.yml
APP_PORT=3000

# Indirizzo pubblico del sito (usato nei link delle email)
PUBLIC_URL=http://localhost:3000

# Email: conferma dell'account e recupero password.
# Lascia SMTP_HOST vuoto per disattivarle (gli account sono attivi subito).
# Il mittente delle email è SMTP_USER, che deve essere un indirizzo email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@tuodominio.it
SMTP_PASSWORD=
# starttls (porta 587), tls (porta 465) oppure none (solo test in locale)
SMTP_TLS=starttls

# Solo per eseguire il backend fuori da Docker (cargo run -p backend)
DATABASE_URL=postgres://tabloza:tabloza@localhost:5432/tabloza
STATIC_DIR=dist
# Abilita CORS per lo sviluppo con `dx serve` (frontend su :8080)
# CORS_ORIGIN=http://localhost:8080
